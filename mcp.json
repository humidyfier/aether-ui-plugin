{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aether-ui": {
      "type": "stdio",
      "command": "node",
      "args": ["--experimental-sqlite", "${PLUGIN_ROOT}/dist/src/mcp/aether-mcp-server.js"],
